{
  "expo": {
    "name": "MathSolver",
    "slug": "mathsolver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathsolver.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MathSolver uses the camera so you can capture a math problem photo.",
        "NSPhotoLibraryUsageDescription": "MathSolver uses your photo library so you can upload a math problem image."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mathsolver.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:3001"
    }
  }
}
